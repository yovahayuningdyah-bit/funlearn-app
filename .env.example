# ============================================================
# EduQuest — konfigurasi environment
# Salin file ini menjadi .env lalu isi nilainya.
#   cp .env.example .env
# Ambil nilai dari: Supabase Dashboard > Project Settings > API
# ============================================================

# URL project Supabase (wajib, contoh: https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co

# Kunci publik (anon / publishable). AMAN dipakai di browser,
# tapi JANGAN pernah memakai service_role / secret key di frontend.
VITE_SUPABASE_ANON_KEY=ISI_ANON_KEY_ATAU_PUBLISHABLE_KEY

# Label project untuk ditampilkan di UI (opsional)
VITE_SUPABASE_PROJECT_REF=PROJECT_REF

# Link repositori GitHub (opsional, tampil di halaman login)
VITE_GITHUB_REPO=https://github.com/yovahayuningdyah-bit/funlearn-app
